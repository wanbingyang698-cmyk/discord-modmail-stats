DISCORD_TOKEN=put_rotated_token_here
GUILD_ID=1128257488375005215
MODMAIL_CATEGORY_ID=1463907222034845858
REPORT_CHANNEL_ID=1526483819664904293
MODMAIL_BOT_ID=575252669443211264

# Asia/Shanghai means weekly reports use China time.
TIMEZONE=Asia/Shanghai

# Weekly report is sent for the previous ISO week on Monday at 00:05.
# Weekday uses JavaScript numbering: 0=Sunday, 1=Monday, ..., 6=Saturday.
WEEKLY_REPORT_WEEKDAY=1
WEEKLY_REPORT_HOUR=0
WEEKLY_REPORT_MINUTE=5

# Commands are accepted in the report channel, for example:
# !modmail-stats 2026-W29
COMMAND_PREFIX=!modmail-stats

# Messages starting with these prefixes are not counted as admin replies.
# Leave empty to count every non-bot human message in the Modmail category.
IGNORE_MESSAGE_PREFIXES=!

# If true, sends a short per-ticket summary when the Modmail channel is deleted.
SEND_CLOSE_LOG=false

# If true, fetches recent messages from currently open tickets at startup.
# Deleted/closed tickets cannot be backfilled because their channels are gone.
BACKFILL_OPEN_TICKETS_ON_START=true
BACKFILL_MESSAGE_LIMIT=500

STORE_PATH=data/modmail-stats.json

# Optional: public check-in form auto reply.
# In this channel, any non-bot message will make Heartopia reply with the form link.
CHECKIN_CHANNEL_ID=1514203944501510295
CHECKIN_FORM_URL=https://forms.gle/wxhXhZpzUseBjeDcA
CHECKIN_REPLY_MESSAGE=这是版主签到表单：\n{form_url}
CHECKIN_ONCE_PER_DAY=true
CHECKIN_DAILY_TIMEZONE=Asia/Shanghai
CHECKIN_COOLDOWN_SECONDS=60
CHECKIN_DELETE_TRIGGER_MESSAGE=false
